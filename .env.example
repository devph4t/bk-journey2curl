# bk-journey2curl settings. Copy this file to .env and edit it:
#   cp .env.example .env
# .env is git-ignored (keep your tenant and secrets there); this example file is committed.
# Command-line flags win over these values; values already set in your shell win over .env.

# Tenant base URL (no trailing slash) and realm used in the generated curl commands
BKJ2C_TENANT=https://openam-CHANGE_ME.forgeblocks.com
BKJ2C_REALM=alpha

# Journey export to read when no file is given on the command line
BKJ2C_EXPORT=test/fixtures/all-journeys-alpha.json

# Output folder for scripts, runbooks, flow pages and the report
BKJ2C_OUT=out

# Journey to run first for journeys that need a session (e.g. UpdatePassword)
BKJ2C_WITH_SESSION=Login

# Optional: fail "bkj2c report/all" (exit 2) when a journey is below this coverage: full | partial | manual
BKJ2C_MIN_COVERAGE=

# Port for "npm run web" (serves the output folder on http://localhost:<port>)
BKJ2C_PORT=5174

# Optional: inputs for running the generated scripts and curl blocks. Load them into your shell with
#   set -a; source .env; set +a
# bkj2c never copies these values into generated files.
# IN_USERNAME=
# IN_PASSWORD=
