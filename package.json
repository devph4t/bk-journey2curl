{
  "name": "bk-journey2curl",
  "version": "0.1.0",
  "description": "Turn a PingOne Advanced Identity Cloud journey export into curl scripts, a flow viewer and a coverage report",
  "type": "module",
  "bin": {
    "bkj2c": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build -c viewer/vite.config.ts --logLevel warn && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p viewer",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run -u",
    "lint": "biome check .",
    "format": "biome check --write .",
    "bkj2c": "node dist/cli.js",
    "build:viewer": "vite build -c viewer/vite.config.ts",
    "dev:viewer": "vite -c viewer/vite.config.ts"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "commander": "^13.1.0",
    "eta": "^3.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^20.19.43",
    "preact": "^10.29.8",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  }
}
