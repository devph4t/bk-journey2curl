#!/usr/bin/env bash
# <%~ it.journey %> — generated by bkj2c from <%~ it.source %>
# Target: <%~ it.target %>   Coverage: <%~ it.coverage %>   Steps: <%~ it.stepCount %>
<% for (const n of it.coverageNotes) { %>#   - <%~ n %>
<% } %>#
# Usage:  IN_USERNAME=... IN_PASSWORD=... ./<%~ it.fileName %>
#         VERBOSE=1 prints every request and response (may include secrets).
<% if (it.resumeStep) { %>#         SUSPENDED_ID=<id from the email link> ./<%~ it.fileName %>   resumes at step <%~ it.resumeStep %>.
<% } %># Needs:  bash 4+, curl, jq 1.6+<% if (it.usesTotp) { %>, oathtool (only for IN_TOTP_SECRET)<% } %>

set -euo pipefail

: "${TENANT:=<%~ it.tenant %>}"
: "${REALM:=<%~ it.realm %>}"
: "${VERBOSE:=0}"
<% for (const v of it.inputs) { %>: "${<%~ v.variable %>:=<%~ v.value %>}"   # <%~ v.description %>
<% } %>
JOURNEY=<%~ it.journeyQuoted %>
JOURNEY_PARAM=<%~ it.journeyParam %>   # URL-encoded
TARGET=<%~ it.target %>

for cmd in curl jq; do
  command -v "$cmd" >/dev/null 2>&1 || { echo "bkj2c: '$cmd' is required" >&2; exit 4; }
done

say() { printf '%s\n' "$*" >&2; }
log() { if [[ "$VERBOSE" == 1 ]]; then printf '%s\n' "$*" >&2; fi; }

realm_path() {
  local r="${REALM#/}"
  if [[ -z "$r" || "$r" == root ]]; then echo "realms/root"; else echo "realms/root/realms/${r//\//\/realms\/}"; fi
}
auth_url() { echo "${TENANT%/}/am/json/$(realm_path)/authenticate?authIndexType=service&authIndexValue=$1"; }

COOKIES="$(mktemp)"
trap 'rm -f "$COOKIES"' EXIT
URL="$(auth_url "$JOURNEY_PARAM")"
RESP=''

# post <json> [curl args...]: POST to the current journey URL, keeping the session in the cookie jar.
post() {
  local body="$1"; shift
  log ">>> POST $URL"
  log "$body"
  local out
  out="$(curl -sS -X POST "$URL" \
    -H 'Content-Type: application/json' \
    -H 'Accept-API-Version: resource=2.1, protocol=1.0' \
    -H 'X-Requested-With: ForgeRock' \
    -b "$COOKIES" -c "$COOKIES" "$@" --data-binary @- <<<"$body")" || { say "✘ curl failed"; exit 4; }
  log "<<< $out"
  printf '%s' "$out"
}
submit() { RESP="$(post "$RESP")"; }
types() { jq -r '[.callbacks[]?.type] | join(",")' <<<"$RESP"; }
done_ok() { jq -e '.tokenId' <<<"$RESP" >/dev/null 2>&1; }

# set_str / set_json / set_jq <callback> <input> <value | json | jq expression>
set_str() { RESP="$(jq --arg v "$3" ".callbacks[$1].input[$2].value = \$v" <<<"$RESP")"; }
set_json() { RESP="$(jq --argjson v "$3" ".callbacks[$1].input[$2].value = \$v" <<<"$RESP")"; }
set_jq() { RESP="$(jq ".callbacks[$1].input[$2].value = ($3)" <<<"$RESP")"; }

finish() {
  if done_ok; then
    if [[ "$TARGET" == failure ]]; then say "✘ $JOURNEY: reached Success, but the plan targets Failure"; exit 1; fi
    say "✔ $JOURNEY: success"
    jq '{tokenId, successUrl, realm}' <<<"$RESP"
    exit 0
  fi
  local got; got="$(types)"
  if [[ -n "$got" ]]; then say "✘ $JOURNEY: the journey still asks for [$got]"; jq . <<<"$RESP" >&2; exit 2; fi
  if [[ "$TARGET" == failure ]]; then say "✔ $JOURNEY: failed as planned ($(jq -r '.message // .code' <<<"$RESP"))"; exit 0; fi
  say "✘ $JOURNEY: $(jq -r '"\(.code // "?") \(.message // "unknown error")"' <<<"$RESP")"
  exit 1
}

# unexpected <step> <expected>: stop with a clear message when the server sends something else.
unexpected() {
  if done_ok; then say "step $1: the journey finished early (expected [$2])"; finish; fi
  local got; got="$(types)"
  if [[ -z "$got" ]]; then
    say "✘ step $1: $(jq -r '"\(.code // "?") \(.reason // "") \(.message // .)"' <<<"$RESP")"
    exit 1
  fi
  say "✘ step $1: expected [$2] but got [$got]"
  jq . <<<"$RESP" >&2
  exit 2
}
check() { [[ "$(types)" == "$2" ]] || unexpected "$1" "$2"; }

suspended() {
  say "⏸ step $1: $(jq -r '[.callbacks[]?.output[]? | select(.name == "message") | .value] | first // "suspended"' <<<"$RESP")"
  say "  Open the link from the email in a browser, or copy its suspendedId and run:"
  say "    SUSPENDED_ID=<id> $0"
  exit 3
}

manual() {
  say "✋ step $1 needs a person: $2"
  say "  Last response:"
  jq . <<<"$RESP" >&2
  exit 5
}

poll() {
  while [[ "$(types)" == *PollingWaitCallback* ]]; do
    local ms
    ms="$(jq -r '[.callbacks[]?.output[]? | select(.name == "waitTime") | .value] | first // 5000' <<<"$RESP")"
    log "polling: waiting ${ms} ms"
    sleep "$(( ${ms%%.*} / 1000 ))"
    submit
  done
}
<% if (it.usesTotp) { %>
otp_code() {
  if [[ -n "${IN_OTP:-}" && "$IN_OTP" != CHANGE_ME ]]; then printf '%s' "$IN_OTP"; return; fi
  if [[ -n "${IN_TOTP_SECRET:-}" ]] && command -v oathtool >/dev/null 2>&1; then oathtool --totp -b "$IN_TOTP_SECRET"; return; fi
  say "✘ a one-time code is needed: set IN_OTP, or IN_TOTP_SECRET with oathtool installed"
  exit 6
}
<% } %>
<%~ it.sessionCode %>
# ---- steps -------------------------------------------------------------------------------------
<%~ it.stepsCode %>
# ---- run ---------------------------------------------------------------------------------------
<% if (it.sessionCall) { %><%~ it.sessionCall %>
<% } %>START=1
if [[ -n "${SUSPENDED_ID:-}" ]]; then
<% if (it.resumeStep) { %>  URL="$URL&suspendedId=$SUSPENDED_ID"
  START="${RESUME_AT:-<%~ it.resumeStep %>}"
<% } else { %>  say "this journey has no suspend step"; exit 4
<% } %>fi
RESP="$(post '{}'<%~ it.firstHeaders %>)"
for ((n = START; n <= <%~ it.stepCount %>; n++)); do "step_$n"; done
finish
